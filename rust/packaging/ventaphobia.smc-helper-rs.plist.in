<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ventaphobia.smc-helper-rs</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/ventaphobia.smc-helper-rs</string>
		<string>serve</string>
		<string>--client-requirement</string>
		<string>@CLIENT_REQUIREMENT@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/ventaphobia.smc-helper-rs.log</string>
</dict>
</plist>
